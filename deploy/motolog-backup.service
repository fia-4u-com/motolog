# /etc/systemd/system/motolog-backup.service にコピーして使う（サーバ作業手順書 P10-5）。

[Unit]
Description=Motolog daily backup

[Service]
Type=oneshot
User=motolog
ExecStart=/usr/bin/python3 /var/www/motolog/bin/backup.py
