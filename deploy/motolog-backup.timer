#
# /etc/systemd/system/motolog-backup.timer にコピーして使う（サーバ作業手順書 P10-5）。

[Unit]
Description=Run Motolog backup every day at 03:00

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true

[Install]
WantedBy=timers.target
